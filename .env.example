APP_NAME=Friday

POSTGRES_USER=friday
POSTGRES_PASSWORD=friday
POSTGRES_DB=friday
# Read-only role for tooling (e.g. the Postgres MCP server) — never grant this role write access.
POSTGRES_READONLY_PASSWORD=changeme

API_PORT=3001
FRONTEND_PORT=8080
REDIS_PORT=6380

# Research agent (Phase 2). Get a key at tavily.com; prod uses Secrets Manager.
TAVILY_API_KEY=

# Bearer token the dashboard sends to api for approvals/research routes.
# Generate one: openssl rand -hex 24
DASHBOARD_TOKEN=

# Calendar agent (Phase 3). Apple ID email + an app-specific password from
# account.apple.com (never the Apple ID password). Agent only.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Calendars to read (comma separated; empty = all) and the one new events go to.
CALENDAR_READ=
CALENDAR_WRITE=Friday
CALENDAR_SYNC_DAYS=30
CALENDAR_SYNC_MINUTES=30

# LLM that turns a typed sentence into an event draft (agent only).
# Primary = Gemini free tier (aistudio.google.com) through its OpenAI-compatible API.
# Fallback = Claude Haiku (console.anthropic.com), tried only when the primary fails.
# A model name starting with "claude-" uses the Anthropic SDK and ignores the base URL.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=claude-haiku-4-5

# Study agent (Phase 4, agent only). Two jobs, each with its own model:
#   STUDY_PLAN      researches a goal and writes the study plan
#   STUDY_MATERIAL  writes cards, quizzes and notes for one chapter
# Leave a key/URL empty to reuse LLM_API_KEY / LLM_BASE_URL above.
# To move a job to Claude: set its model to claude-opus-5-5 or claude-sonnet-5-5 and
# put an Anthropic key (sk-ant-...) in its _API_KEY. The base URL is ignored for Claude.
STUDY_PLAN_API_KEY=
STUDY_PLAN_BASE_URL=
STUDY_PLAN_MODEL=gemini-flash-lite-latest
STUDY_MATERIAL_API_KEY=
STUDY_MATERIAL_BASE_URL=
STUDY_MATERIAL_MODEL=gemini-flash-lite-latest
# Safety cap on model calls per 24 hours across the study agent.
STUDY_DAILY_CALLS=40
# Language of cards and quiz questions: zh-TW (all Traditional Chinese, English terms kept)
# or en (English questions, Chinese explanations).
STUDY_MATERIAL_LANGUAGE=zh-TW
